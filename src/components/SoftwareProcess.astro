---
import { softwarePage } from '../utils/content';
---

<section id="como-trabajamos" class="py-20 bg-tecni-lavender">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12 reveal">
      <h2 class="text-3xl md:text-4xl font-bold text-tecni-dark mb-4">
        {softwarePage.processTitle}
      </h2>
      <p class="text-tecni-dark/60 max-w-xl mx-auto">
        {softwarePage.processSubtitle}
      </p>
    </div>

    <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 reveal-cascade">
      {
        softwarePage.process.map((item) => (
          <li class="reveal flex flex-col gap-3 p-6 bg-white rounded-2xl shadow-sm">
            <span
              class="w-10 h-10 rounded-full bg-tecni-purple text-white font-bold flex items-center justify-center"
              aria-hidden="true"
            >
              {item.step}
            </span>
            <h3 class="font-bold text-tecni-dark">{item.title}</h3>
            <p class="text-sm text-tecni-dark/60 leading-relaxed">{item.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
