---
import { softwarePage } from '../utils/content';
---

<section class="bg-tecni-purple">
  <div
    class="max-w-6xl mx-auto px-4 py-10 md:py-12 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left reveal"
  >
    <p class="text-white font-medium text-lg md:text-xl max-w-2xl leading-snug">
      {softwarePage.homeBanner.text}
    </p>
    <a
      href="/software"
      class="shrink-0 inline-flex items-center justify-center bg-white text-tecni-purple font-medium px-6 py-3 rounded-xl hover:bg-tecni-lavender hover:-translate-y-0.5 transition"
    >
      {softwarePage.homeBanner.button}
    </a>
  </div>
</section>
