---
import { about } from '../utils/content';
---

<section id="nosotros" class="py-20 bg-tecni-lavender">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="flex flex-col gap-6 reveal">
        <div
          class="inline-flex items-center gap-2 bg-tecni-purple/10 text-tecni-purple text-sm font-medium px-3 py-1 rounded-full w-fit"
        >
          {about.badge}
        </div>

        <h2 class="text-3xl md:text-4xl font-bold text-tecni-dark">
          {about.title}
        </h2>

        {about.paragraphs.map((paragraph) => (
          <p class="text-tecni-dark/70 leading-relaxed">{paragraph}</p>
        ))}

        <div class="flex flex-col gap-3">
          {about.highlights.map((highlight) => (
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-tecni-purple/10 flex items-center justify-center shrink-0">
                {highlight.icon === 'location' ? (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="w-5 h-5 text-tecni-purple"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-2.003 3.5-4.697 3.5-8.319a6.5 6.5 0 00-13 0c0 3.622 1.556 6.316 3.5 8.319a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742z"
                      clip-rule="evenodd"
                    />
                  </svg>
                ) : (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="w-5 h-5 text-tecni-purple"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A12.697 12.697 0 0112 22.5c-2.233 0-4.367-.45-6.314-1.7a.75.75 0 01-.435-.695z"
                      clip-rule="evenodd"
                    />
                  </svg>
                )}
              </div>
              <div>
                <p class="font-medium text-tecni-dark">{highlight.title}</p>
                <p class="text-sm text-tecni-dark/50">{highlight.subtitle}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="flex justify-center reveal">
        <div class="relative w-64 h-64 md:w-80 md:h-80">
          <div class="absolute inset-0 bg-tecni-purple/20 rounded-3xl blur-3xl"></div>
          <img
            src="/logo.png"
            alt="Logo TecniCopa"
            width="320"
            height="320"
            class="relative w-full h-full object-contain rounded-3xl"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="mt-16 reveal">
      <h3 class="text-xl font-bold text-tecni-dark text-center mb-8">{about.founderTitle}</h3>
      <div class="max-w-md mx-auto">
        <div class="flex flex-col items-center text-center gap-3 p-6 bg-white rounded-2xl shadow-sm">
          <div class="w-14 h-14 rounded-full bg-tecni-purple flex items-center justify-center">
            <span class="text-white font-bold text-xl" aria-hidden="true">
              {about.founder.name.charAt(0)}
            </span>
          </div>
          <div>
            <p class="font-bold text-tecni-dark">
              {about.founder.name}
              <span class="text-tecni-dark/40 font-medium"> — </span>
              <span class="text-tecni-purple font-medium">{about.founder.role}</span>
            </p>
            <p class="text-sm text-tecni-dark/60 mt-1">{about.founder.description}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
