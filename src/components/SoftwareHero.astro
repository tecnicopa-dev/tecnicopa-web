---
import { softwarePage } from '../utils/content';
import { WHATSAPP_SOFTWARE_URL } from '../utils/links';
---

<section class="min-h-[80vh] flex items-center bg-gradient-to-b from-tecni-lavender to-white pt-16">
  <div class="max-w-6xl mx-auto px-4 py-16 md:py-24">
    <div class="max-w-3xl flex flex-col gap-6">
      <div
        class="inline-flex items-center gap-2 bg-tecni-purple/10 text-tecni-purple text-sm font-medium px-3 py-1 rounded-full w-fit"
      >
        <span class="w-2 h-2 bg-tecni-purple rounded-full animate-pulse"></span>
        {softwarePage.hero.badge}
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-tecni-dark leading-tight">
        {softwarePage.hero.title}
      </h1>

      <p class="text-lg text-tecni-dark/70 max-w-2xl">
        {softwarePage.hero.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href={WHATSAPP_SOFTWARE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-tecni-purple text-white font-medium px-6 py-3 rounded-xl hover:bg-tecni-purple/90 hover:-translate-y-0.5 transition text-lg"
        >
          {softwarePage.hero.primaryCta}
        </a>
        <a
          href={softwarePage.hero.secondaryHref}
          class="inline-flex items-center justify-center gap-2 border-2 border-tecni-lilac text-tecni-purple font-medium px-6 py-3 rounded-xl hover:bg-tecni-lavender hover:-translate-y-0.5 transition text-lg"
        >
          {softwarePage.hero.secondaryCta}
        </a>
      </div>
    </div>
  </div>
</section>
