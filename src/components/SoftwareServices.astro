---
import { softwarePage } from '../utils/content';
---

<section id="servicios-software" class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12 reveal">
      <h2 class="text-3xl md:text-4xl font-bold text-tecni-dark mb-4">
        {softwarePage.servicesTitle}
      </h2>
      <p class="text-tecni-dark/60 max-w-xl mx-auto">
        {softwarePage.servicesSubtitle}
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-6 reveal-cascade">
      {
        softwarePage.services.map((service) => (
          <article class="reveal flex flex-col gap-3 p-6 rounded-2xl border border-tecni-lilac/40 hover:border-tecni-purple/40 hover:shadow-md hover:-translate-y-1 transition-all">
            <h3 class="font-bold text-tecni-dark text-lg">{service.title}</h3>
            <p class="text-sm text-tecni-dark/60 leading-relaxed">{service.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
