---
import { WHATSAPP_URL } from '../utils/links';
import { NAV_LINKS, headerCtaLabel } from '../utils/content';
---

<header class="fixed top-0 w-full bg-white/90 backdrop-blur-sm border-b border-tecni-lilac/30 z-50">
  <nav class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between" aria-label="Principal">
    <a href="/" data-scroll-top class="flex items-center gap-2">
      <img src="/logo.png" alt="TecniCopa" width="40" height="40" class="h-10 w-10 rounded-lg" />
      <span class="text-xl font-bold text-tecni-purple">TecniCopa</span>
    </a>

    <ul class="hidden md:flex items-center gap-6">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a href={link.href} class="text-sm text-tecni-dark/70 hover:text-tecni-purple transition-colors">
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium bg-tecni-purple text-white px-4 py-2 rounded-lg hover:bg-tecni-purple/90 transition"
        >
          {headerCtaLabel}
        </a>
      </li>
    </ul>

    <button
      type="button"
      id="menu-toggle"
      class="md:hidden p-2 text-tecni-dark rounded-lg"
      aria-label="Abrir menú"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <span aria-hidden="true">☰</span>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden border-t border-tecni-lilac/30 bg-white">
    <ul class="flex flex-col px-4 py-4 gap-3">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a href={link.href} class="block py-2 text-tecni-dark/70 hover:text-tecni-purple">
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="block text-center font-medium bg-tecni-purple text-white px-4 py-3 rounded-xl"
        >
          {headerCtaLabel}
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  };

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    setOpen(open);
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });
</script>
