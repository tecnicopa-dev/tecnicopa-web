---
import type { PageHero as PageHeroContent } from '../utils/content';
import CtaButton from './CtaButton.astro';

interface Props {
  content: PageHeroContent;
  primaryHref: string;
}

const { content, primaryHref } = Astro.props;
---

<section class="min-h-[70vh] flex items-center pt-16">
  <div class="max-w-6xl mx-auto px-4 py-16 md:py-24">
    <div class="max-w-3xl flex flex-col gap-6 reveal">
      <p class="text-sm font-medium text-tecni-purple">{content.badge}</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-tecni-dark leading-tight">
        {content.title}
      </h1>
      <p class="text-lg text-tecni-dark/70 max-w-2xl">{content.subtitle}</p>
      <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4">
        <CtaButton href={primaryHref}>{content.primaryCta}</CtaButton>
        <CtaButton href={content.secondaryHref} variant="secondary">{content.secondaryCta}</CtaButton>
      </div>
    </div>
  </div>
</section>
