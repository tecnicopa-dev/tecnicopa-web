---
import CtaButton from './CtaButton.astro';

interface Props {
  title: string;
  subtitle: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  equal?: boolean;
}

const {
  title,
  subtitle,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  equal = false,
} = Astro.props;
---

<div class="max-w-2xl mx-auto text-center flex flex-col items-center gap-6 reveal">
  <h2 class="text-3xl md:text-4xl font-bold">{title}</h2>
  <p class="text-white/60">{subtitle}</p>
  <div class="flex flex-col sm:flex-row w-full sm:w-auto gap-3">
    <CtaButton href={primaryHref} variant={equal ? 'inverse' : 'inverse'}>{primaryLabel}</CtaButton>
    {
      secondaryLabel && secondaryHref && (
        <CtaButton href={secondaryHref} variant="inverse">
          {secondaryLabel}
        </CtaButton>
      )
    }
  </div>
</div>
